  <div class="pl-24 pr-24 " style="padding-top:150px;">
    <div class="bg-white h-20 rounded-2xl border min-w-full table-auto border-collapse" style="position: sticky;top: 138px; box-shadow: 0px 0px 15px 3px lightgray; max-width:80%;">

    <div class="hidden sm:ml-6 sm:block pt-4">
          <p class="rounded-md px-3 py-2 font-bold text-2xl">Family Leader's </p>
        </div>

                <%= search_form_for @q do |f| %>
                    <div class="" style="right:40%; position: absolute; top:18px;">
                      <%= f.text_field :search_cont, placeholder:'Search', class:"rounded w-96 bg-gray-100 border-gray-100 border", style:" outline: 2px solid transparent; --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(0px + var(--tw-ring-offset-width)) #ffffff00; border-color:#ffffff00; "%> 
                        <button type="submit" class="rounded-r-3xl  items-center" style="position: absolute; right:-2px; width:50px; height:35px; color:black; margin-top:3px; "><i class="material-icons" style="padding-top:5px; padding-right:5px;">search</i></button>
                    </div>
                <% end %>

                <div style="right:20%; position: absolute; top:25px; ">  
                  <%= link_to 'All Family Members', all_member_familymembers_path(member_id: 1), class: "btn btn-primary rounded-3xl hover:bg-white hover:text-red-600 text-red-600 border-none p-1.5 px-1.5 font-semibold", style:"font-size:18px;" %>
                </div>
                <div style="right:20px; position: absolute; top:20px; ">
                 <%= link_to download_csv_memberdownloads_path, class: "btn btn-primary rounded-3xl hover:bg-white hover:text-red-600 text-red-600 border-none p-1.5 px-1.5 font-semibold", style:"font-size:18px;" do %> Download<i class="material-icons" style="top:5px; position: relative;">download</i> <% end %>
