<div class="bg-gray-100 w-full h-12" style="position: sticky;top: 90px;">
</div>
<div>
<div class="pl-24 pr-24 " style="margin-top:90px;">
      <div class="bg-white h-20 rounded-t-2xl border" style="position: sticky;top: 138px; box-shadow: 0px 1px 12px 15px lightgray">
            <div class="hidden sm:ml-6 sm:block pt-4">
                <p class="rounded-md px-3 py-2 font-bold text-2xl">Members list</p>
            </div>
            
            <%= search_form_for @q do |f| %>
                <div class="" style="right:400px; position: absolute; top:20px;">
                  <%= f.text_field :search_cont, placeholder:'Search Members', class:"rounded w-96 bg-gray-100 border-gray-100 border", style:" outline: 2px solid transparent; --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(0px + var(--tw-ring-offset-width)) #ffffff00; border-color:#ffffff00; "%> 
                    <button type="submit" class="rounded-r-3xl  items-center" style="position: absolute; right:-2px; width:50px; height:35px; color:black; margin-top:3px; "><i class="material-icons" style="padding-top:5px; padding-right:5px;">search</i></button>
                </div>
            <% end %>

            <div class="hover:bg-transparent hover:text-red-600" style="right:50px; position: absolute; top:30px; ">
            <%= link_to "Download Member List", download_csv_memberdownloads_path, class: "btn btn-primary hover:bg-transparent hover:text-sky-800", style:"border:none;" %>
            </div>
      </div>
  <table class="min-w-full table-auto border-collapse" style="box-shadow: 0px 1px 12px 15px lightgray">
    <thead class="bg-gray-100 border-b border-black"  style="position: sticky; top: 217px;">
      <tr class="border-b border-gray-400 border-t font-bold">
        <th class="px-4 py-2 border-black" >SI No.</th>
        <th class="px-4 py-2 border-black">Name of Beneficiary</th>
        <th class="px-4 py-2 border-black">Name of family members</th>
        <th class="px-4 py-2 border-black">Present address</th>
        <th class="px-4 py-2 border-black">Permanent address</th>
        <th class="px-4 py-2 border-black">Polling station</th>
        <th class="px-4 py-2 border-black">Type of assistance provided (Amount)</th>
        <th class="px-4 py-2 border-black">Provided through whom (Leader)</th>
        <th class="px-4 py-2 border-black">Mobile number</th>
        <th class="px-4 py-2 border-black">Election Epic No.</th>
        <th class="px-4 py-2 border-black">House No.</th>
      </tr>
    </thead>
    <tbody>
      <% @members.each_with_index do |member, index| %>
        <tr class="border-t hover:bg-gray-100 bg-white border-b border-black">
          <td class="px-4 py-2 text-center  border-black"><%= index + 1 %></td>
          <td class="px-4 py-2 text-center  border-black font-bold"><%= member.username %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.family_members_name %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.present_address %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.permanent_address %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.polling_station %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.amount %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.leader %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.mobile_number %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.election_number %></td>
          <td class="px-4 py-2 text-center  border-black"><%= member.house_number %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
</div>
    <div style=" padding:0 25% 0 30%">
    <div style="padding-top:35px; padding-bottom:35px;">
    <%= will_paginate @members, class: "pagination" %>
    </div>
    </div>
</div>
